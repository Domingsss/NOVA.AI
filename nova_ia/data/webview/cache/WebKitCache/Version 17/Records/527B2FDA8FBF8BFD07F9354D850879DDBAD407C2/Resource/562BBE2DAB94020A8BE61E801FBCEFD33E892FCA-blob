#dashboard-insight { display: flex; align-items: center; gap: 8px; margin-top: 15px; color: #82769f; max-width: 680px; }#dashboard-insight > span { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; color: #9f72ff; background: #1e1735; font-size: 8px; }#dashboard-insight p { margin: 0; font-size: 10px; line-height: 1.6; }
.dashboard-refresh { border: 0; background: transparent; box-shadow: none; font-size: 17px; color: #897bb2; }
#dashboard-grid { max-width: 1280px; grid-template-columns: minmax(0, 1.2fr) minmax(320px, .95fr); gap: 14px; }
.dash-card { min-height: 210px; border-radius: 16px; border-color: #2b2344; background: #0e0c17; padding: 20px; box-shadow: none; }
.dash-card::after { display: none; }.dash-card-label { font-size: 8px; letter-spacing: 1.2px; color: #8c80ad; margin-bottom: 16px; }
.dash-weather { background: #1c1634; }
.weather-main { gap: 18px; }.weather-icon { font-size: 58px; color: #ffb01f; }.weather-main > strong { font-size: 54px; font-weight: 700; letter-spacing: -4px; }.weather-main div b { font-size: 14px; }.weather-main div small { font-size: 11px; color: #9082b4; }
.weather-stats { grid-template-columns: repeat(4,1fr); border-color: #332650; gap: 10px; margin-top: 24px; }.weather-stats span { flex-direction: column; gap: 8px; text-transform: uppercase; font-size: 8px; }.weather-stats b { font-size: 11px; color: #f4f0ff; }
