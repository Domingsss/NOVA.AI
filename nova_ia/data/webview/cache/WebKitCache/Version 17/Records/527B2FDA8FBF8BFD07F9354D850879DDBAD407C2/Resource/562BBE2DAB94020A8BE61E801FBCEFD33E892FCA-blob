.sessao-item { min-height: 33px; border-radius: 7px; padding-left: 7px; }
.sessao-item::after { content: "▢"; order: -1; color: #9185b2; font-size: 10px; }
.sessao-item.ativa::before { display: none; }
.sessao-titulo { font-size: 10px; padding: 7px 5px; }
#nav { flex: 1; display: flex; flex-direction: column; gap: 2px; padding: 10px 7px; border-top: 1px solid var(--sidebar-border); }
.rotinas-label { margin-top: 2px; padding: 10px 12px 3px; border-top: 1px solid var(--sidebar-border); }
#nav { border-top: 0; padding-top: 4px; gap: 4px; }
