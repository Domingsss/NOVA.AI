}
@media (max-width: 900px) {
  .dash-weather .weather-stats { grid-template-columns: repeat(2, minmax(0,1fr)); }
}
@media (max-width: 560px) {
  .dash-weather .weather-main { grid-template-columns: auto auto; }
  .dash-weather .weather-main div { grid-column: 1 / -1; }
}

/* Céu animado global — acompanha todas as abas e rotinas */
#conteudo > #chat-particles { position: absolute; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; opacity: .72; }
#conteudo > #chat-particles .particle { box-shadow: 0 0 7px currentColor; }
#conteudo > #app-topbar { position: relative; z-index: 3; }
#conteudo > .aba { position: relative; z-index: 0; }
body:not([data-theme="dark"]) #conteudo > #chat-particles { opacity: .32; }
@media (prefers-reduced-motion: reduce) { #conteudo > #chat-particles .particle { animation-duration: 40s; } }

/* Compositor da conversa */
#chat-input-area { padding: 14px 20px 18px; background: linear-gradient(180deg,transparent 0%,rgba(9,8,18,.9) 32%,#090812 72%); }
#chat-input-wrap {
  position: relative; min-height: 60px; padding: 8px 9px 8px 12px; align-items: center; gap: 7px;
  border: 1px solid #33294b; border-radius: 22px;
  background: linear-gradient(145deg,rgba(25,21,38,.97),rgba(15,13,25,.98));
  box-shadow: 0 12px 35px rgba(0,0,0,.28), inset 0 1px 0 rgba(255,255,255,.025);
  transition: border-color .22s ease,box-shadow .22s ease,transform .22s ease;
}
#chat-input-wrap::before {
  content: ""; position: absolute; inset: -1px; z-index: -1; border-radius: 22px;
  background: linear-gradient(115deg,rgba(139,92,246,.5),transparent 35%,transparent 68%,rgba(192,38,211,.35));
  opacity: 0; transition: opacity .22s ease;
}
#chat-input-wrap:focus-within { border-color: rgba(159,114,255,.78); box-shadow: 0 14px 42px rgba(0,0,0,.34),0 0 0 4px rgba(124,58,237,.09),0 0 28px rgba(124,58,237,.12); transform: translateY(-1px); }
#chat-input-wrap:focus-within::before { opacity: 1; }
#chat-input { min-height: 42px; padding: 11px 5px; font-size: 14px; line-height: 1.45; }
#chat-input::placeholder { color: #756b8d; }
#btn-anexar,#chat-mic { width: 40px; height: 40px; border-radius: 50%; color: #8f83aa; }
#btn-anexar:hover,#chat-mic:hover { color: #c7b7ff; background: #241d39; box-shadow: inset 0 0 0 1px #392d55; }
#chat-send { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg,#8b5cf6,#b933d1); box-shadow: 0 7px 18px rgba(124,58,237,.32),inset 0 1px 0 rgba(255,255,255,.2); }
#chat-send:hover { background: linear-gradient(135deg,#9f72ff,#d044e7); box-shadow: 0 9px 24px rgba(124,58,237,.42); transform: translateY(-1px); }
#chat-send svg { width: 18px; height: 18px; stroke-width: 2.2; }
#chat-mic svg,#btn-anexar svg { width: 18px; height: 18px; }
body:not([data-theme="dark"]) #chat-input-area { background: linear-gradient(180deg,transparent 0%,rgba(246,244,251,.92) 35%,#f6f4fb 72%); }
body:not([data-theme="dark"]) #chat-input-wrap { background: rgba(255,255,255,.96); border-color: #ddd5e8; box-shadow: 0 12px 35px rgba(65,42,96,.11),inset 0 1px 0 #fff; }
body:not([data-theme="dark"]) #chat-input-wrap:focus-within { border-color: #9b75ee; box-shadow: 0 14px 38px rgba(65,42,96,.14),0 0 0 4px rgba(124,58,237,.08); }
body:not([data-theme="dark"]) #btn-anexar:hover,body:not([data-theme="dark"]) #chat-mic:hover { background: #eee8f8; color: #7048d7; }
