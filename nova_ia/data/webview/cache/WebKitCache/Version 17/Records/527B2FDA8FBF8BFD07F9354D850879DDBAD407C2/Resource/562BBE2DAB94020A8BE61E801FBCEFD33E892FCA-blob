.dash-card-head { display: flex; justify-content: space-between; align-items: flex-start; }.dash-card-head button { color: #9f72ff; background: transparent; border: 0; font: 9px var(--font); cursor: pointer; }
.mini-progress { display: flex; gap: 8px; align-items: center; margin-top: -8px; }.mini-progress > i { display: block; width: 95px; height: 3px; background: #241d39; border-radius: 4px; overflow: hidden; }.mini-progress > i::after { content: ""; display: block; width: var(--progress,0%); height: 100%; background: #8b5cf6; }.mini-progress span { font-size: 8px; color: #74698f; }
.dashboard-list { display: flex; flex-direction: column; gap: 5px; }.dashboard-row { min-height: 34px; display: flex; align-items: center; gap: 10px; padding: 4px 8px; border-radius: 8px; cursor: pointer; }.dashboard-row:hover { background: #151225; }.dashboard-check { width: 15px; height: 15px; border: 1px solid #35285b; border-radius: 50%; display: grid; place-items: center; color: transparent; font-size: 8px; }.dashboard-row.done .dashboard-check,.dashboard-check.done { color: #fff; background: #8056ec; }.dashboard-row.done .dashboard-row-name { text-decoration: line-through; color: #73698d; }.dashboard-row-name { flex: 1; font-size: 11px; color: #ddd6ed; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }.priority-dot { width: 5px; height: 5px; border-radius: 50%; }.dashboard-habit-icon { width: 30px; height: 30px; border-radius: 50%; background: #17132a; display: grid; place-items: center; }.habit-data { flex: 1; }.habit-data > div { font-size: 11px; }.habit-data small { font-size: 8px; color: #29c7c7; }.habit-dots { display: flex; gap: 3px; margin-top: 5px; }.habit-dots i { width: 6px; height: 6px; border-radius: 50%; background: #2a2440; }.habit-dots i.on { background: #8056ec; }
.dash-weather { order: 1; }.dash-system { order: 2; grid-column: 2 / 3; min-height: 210px; padding-bottom: 14px; }.dash-tasks { order: 3; }.dash-habits { order: 4; }.dash-shortcuts { order: 5; grid-column: 1 / 2; min-height: 155px; }.dash-finance { order: 6; grid-column: 2 / 3; min-height: 155px; }.quick-actions button { background: #14111f; border-color: #241d39; }.nova-ascii { display: none; }.system-lines { columns: 2; column-gap: 15px; font-size: 9px; }.system-lines > div { break-inside: avoid; }.system-lines span { width: 47px; }.terminal-colors { display: none; }
.dashboard-footer { max-width: 1280px; }

